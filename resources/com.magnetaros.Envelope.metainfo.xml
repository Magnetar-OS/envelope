<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.entro314labs.Envelope</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <!-- What marks this as part of the COSMIC set rather than a generic GTK app. -->
  <project_group>COSMIC</project_group>

  <name>Envelope</name>
  <summary>Read and write your mail</summary>

  <developer id="io.github.entro314labs">
    <name>entro314 labs</name>
  </developer>

  <url type="homepage">https://github.com/Magnetar-OS/envelope</url>
  <url type="bugtracker">https://github.com/Magnetar-OS/envelope/issues</url>
  <url type="vcs-browser">https://github.com/Magnetar-OS/envelope</url>

  <description>
    <p>
      Mail for the COSMIC desktop. Messages are stored as ordinary maildirs, so
      they interoperate with mbsync, notmuch, mu, and mutt — and stay readable
      if you stop using Envelope.
    </p>
    <ul>
      <li>IMAP, with folders, flags, and durable writeback</li>
      <li>Conversations, threaded the way replies actually reference each other</li>
      <li>Search across folders by sender, subject, and first line</li>
      <li>Compose, reply, forward, and attachments, with an outbox for when you are offline</li>
      <li>Drafts kept on your own machine</li>
      <li>Keyboard shortcuts throughout</li>
      <li>Shares its accounts with Slate and Circle</li>
    </ul>
    <p>
      Messages are shown as text rather than rendered as HTML. Remote images
      cannot load, so a message cannot tell its sender that you opened it, and
      text a message hides from you is reported rather than silently dropped.
    </p>
  </description>

  <launchable type="desktop-id">io.github.entro314labs.Envelope.desktop</launchable>
  <icon type="remote" width="64" height="64" scale="1">https://raw.githubusercontent.com/Magnetar-OS/envelope/main/resources/icons/hicolor/scalable/apps/icon.svg</icon>

  <!-- How the COSMIC App Library and store recognise a COSMIC application, and
       which binary and file types this component actually provides. -->
  <provides>
    <id>com.system76.CosmicApplication</id>
    <mediatype>message/rfc822</mediatype>
    <mediatype>x-scheme-handler/mailto</mediatype>
    <binary>envelope</binary>
  </provides>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <categories>
    <category>Network</category>
    <category>Email</category>
  </categories>

  <keywords>
    <keyword>mail</keyword>
    <keyword>email</keyword>
    <keyword>message</keyword>
    <keyword>inbox</keyword>
    <keyword>imap</keyword>
  </keywords>

  <content_rating type="oars-1.1"/>

  <branding>
    <color type="primary" scheme_preference="light">#94bfe7</color>
    <color type="primary" scheme_preference="dark">#274768</color>
  </branding>

  <releases>
    <release version="0.1.0" date="2026-08-24">
      <description>
        <p>Initial release.</p>
      </description>
    </release>
  </releases>
</component>
